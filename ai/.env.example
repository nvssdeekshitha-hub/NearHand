# NEARHAND AI Integration Layer Configuration

# AI LLM Provider Configuration
# Supported providers: gemini, openai, anthropic, standard_http, mock
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=20
ENABLE_AI_FALLBACK=true

# Speech-to-Text Configuration
# Supported providers: mock, whisper_api, openai
SPEECH_PROVIDER=mock
SPEECH_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
